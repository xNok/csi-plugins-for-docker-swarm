{
	"description": "Rclone CSI driver for Docker Swarm",
	"documentation": "https://github.com/olljanat/csi-plugins-for-docker-swarm",
	"entrypoint": [
		"/entrypoint.sh"
	],
	"env": [
		{
			"name": "S3_PROVIDER",
			"description": "S3 Provider Name",
			"settable": [
				"value"
			],
			"value": "Minio | AWS"
		},
		{
			"name": "S3_ENDPOINT",
			"description": "S3 Provider Endpoint",
			"settable": [
				"value"
			],
			"value": null
		},
		{
			"name": "S3_ACCESS_KEY_ID",
			"description": "S3 Access Key ID",
			"settable": [
				"value"
			],
			"value": null
		},
		{
			"name": "S3_SECRET_ACCESS_KEY",
			"description": "S3 Secret Access Key",
			"settable": [
				"value"
			],
			"value": null
		}
	],
	"interface": {
		"socket": "csi-rclone.sock",
		"types": [
			"docker.csicontroller/1.0",
			"docker.csinode/1.0"
		]
	},
	"linux": {
		"capabilities": [
			"CAP_SYS_ADMIN"
		]
	},
	"mounts": [],
	"network": {
		"type": "host"
	},
	"propagatedmount": "/data/published"
}